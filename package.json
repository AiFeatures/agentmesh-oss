{
  "name": "agentmesh-oss",
  "private": true,
  "version": "0.1.0",
  "description": "AgentMesh open-source coordination hub",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @agentmesh/hub dev",
    "start": "pnpm --filter @agentmesh/hub start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "battle:test": "tsx scripts/battle-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/node": "^25.2.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
